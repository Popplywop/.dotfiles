# Gruber Darker color scheme for KDE
# Palette:
#   bg-1  #101010   bg    #181818   bg+1  #282828
#   bg+2  #453d41   bg+3  #484848   bg+4  #52494e
#   fg    #e4e4ef   fg+1  #f4f4ff
#   red   #f43841   green #73c936   yellow #ffdd33
#   brown #cc8c3c   quartz #95a99f  niagara #96a6c8
#   niagara-1 #5f627f              wisteria #9e95c7

[ColorEffects:Disabled]
