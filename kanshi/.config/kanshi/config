# Kanshi display profile configuration
#
# Profile: laptop display only (no external connected)
profile laptop_only {
    output eDP-1 enable position 0,0
}

# Profile: any external monitor, laptop display disabled.
# "*" matches whichever output the monitor shows up as (DP-x, HDMI-A-x...).
profile external_only {
    output eDP-1 disable
    output * enable
}
