# Kanshi display profile configuration
#
# Profile: laptop display only (no external connected)
profile laptop_only {
    output eDP-1 enable position 0,0
}

# Profile: external monitor only (laptop display disabled)
# Replace EXTERNAL_OUTPUT below with your actual output name.
# To find it: plug in your monitor and run: hyprctl monitors all
profile external_only {
    output DP-1 enable position 0,0
    output eDP-1 disable
}
