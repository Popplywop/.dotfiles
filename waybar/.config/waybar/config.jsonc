// Waybar config for Hyprland
// Place at: ~/.config/waybar/config.jsonc

{
    // ── Bar geometry ──────────────────────────────────────────
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 36,

    // ── Module layout ─────────────────────────────────────────
    "modules-left": [
        "custom/launcher",
        "custom/weather",
        "custom/clock",
        "wlr/taskbar"
    ],

    "modules-center": [
        "hyprland/workspaces"
    ],

    "modules-right": [
        "tray",
        "battery",
        "pulseaudio",
        "backlight",
        "cpu",
        "memory",
        "disk",
        "custom/updates",
        "network",
        "custom/lock_screen",
        "custom/power"
    ],

    // ── Left modules ──────────────────────────────────────────

    "custom/launcher": {
        "format": " 󱓞",
        "on-click": "wofi --show drun",
        "tooltip": false
    },

    "custom/weather": {
        "tooltip": true,
        "format": "{}",
        "interval": 1800,
        "exec": "~/.config/waybar/scripts/wttr.py",
        "return-type": "json"
    },

    "custom/clock": {
        "exec": "~/.config/waybar/scripts/clock-tooltip",
        "return-type": "json",
        "interval": 60,
        "tooltip": true
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 12,
        "all-outputs": true,
        "tooltip-format": "{name}: {title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": []
    },

    // ── Center modules ────────────────────────────────────────

    "hyprland/workspaces": {
        "all-outputs": true,
        "format": "{id}",
        "on-click": "activate"
    },

    // ── Right modules ─────────────────────────────────────────

    "tray": {
        "icon-size": 12,
        "spacing": 10
    },

    "battery": {
        "format": "{icon} ",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "plugged": ""
        },
        "format-alt-click": "click-right",
        "format-alt": "{icon} {capacity}%",
        "states": {
            "good": 95,
            "warning": 20,
            "critical": 10
        }
    },

    "pulseaudio": {
        "format": "{icon} ",
        "format-muted": "󰝟",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
        "scroll-step": 5,
        "format-icons": {
            "default": ""
        },
        "tooltip": true,
        "tooltip-format": "{icon}  at {volume}%"
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}",
        "format-alt-click": "click-right",
        "format-alt": "{icon} {percent}%",
        "format-icons": ["󰃞 ", "󰃟 ", "󰃠 "],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-",
        "tooltip": false
    },

    "cpu": {
        "interval": 10,
        "format": " ",
        "max-length": 10,
        "format-alt-click": "click-right",
        "format-alt": "{usage}%"
    },

    "memory": {
        "interval": 30,
        "format": "󰍛 ",
        "format-alt-click": "click-right",
        "format-alt": " {}%",
        "max-length": 10,
        "tooltip": true,
        "tooltip-format": "Memory - {used:0.1f}GB used"
    },

    "disk": {
        "interval": 600,
        "format": "󰋊 ",
        "path": "/",
        "format-alt-click": "click-right",
        "format-alt": "󰋊 {percentage_used}%",
        "tooltip": true,
        "tooltip-format": "HDD - {used} used out of {total} on {path} ({percentage_used}%)",
        "states": {
            "warning": 85,
            "critical": 90
        }
    },

    "custom/updates": {
        // Send signal 8 to waybar after running updates to refresh: killall -SIGUSR1 waybar
        "format": "{}",
        "exec": "~/.config/waybar/scripts/update-sys",
        "on-click": "~/.config/waybar/scripts/update-sys update",
        "interval": 300,
        "tooltip": true,
        "signal": 8,
        "return-type": "json"
    },

    "network": {
        "format-wifi": "  ",
        "format-ethernet": "󰈁 ",
        "format-disconnected": "󰈂 ",
        "tooltip-format": " {ifname} via {gwaddr}",
        "tooltip-format-wifi": " {essid} ({signalStrength}%)",
        "tooltip-format-ethernet": " {ifname} {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 60
    },

    "custom/lock_screen": {
        "format": " ",
        "on-click": "sh -c '(sleep 0.5s; hyprlock)' & disown",
        "tooltip": false
    },

    "custom/power": {
        "format": "⏻ ",
        "on-click": "~/.config/waybar/scripts/power-menu",
        "tooltip": false
    }
}
