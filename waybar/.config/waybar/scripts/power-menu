#!/usr/bin/env bash
# ~/.config/waybar/scripts/power-menu

CHOICE=$(printf '󰌾  Lock\n󰍃  Logout\n󰑐  Reboot\n󰐥  Shutdown' \
    | wofi --dmenu --prompt "Power" --width 20% --height 20% --no-actions)

case "$CHOICE" in
    *Lock)     hyprlock ;;
    *Logout)   hyprctl dispatch exit ;;
    *Reboot)   systemctl reboot ;;
    *Shutdown) systemctl poweroff ;;
esac
