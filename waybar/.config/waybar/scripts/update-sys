#!/usr/bin/env bash
# ~/.config/waybar/scripts/update-sys
# Pacman/yay update checker for Waybar
# After running updates, signal waybar to refresh: killall -SIGUSR1 waybar

if [ ! -f /etc/arch-release ]; then
    exit 0
fi

if [ "$1" = "update" ]; then
    uwsm app -- wezterm start --class wezterm-updates -- yay -Syu
    pkill -SIGRTMIN+8 waybar
    exit 0
fi

OFFICIAL=$(checkupdates 2>/dev/null | wc -l)
AUR=$(yay -Qteu 2>/dev/null | wc -l)
COUNT=$((OFFICIAL + AUR))

if [ "$COUNT" = "0" ]; then
    printf '{"text": "0 ", "tooltip": "System up to date"}\n'
else
    printf '{"text": "%s ", "tooltip": "%s updates (%s official, %s AUR)"}\n' \
        "$COUNT" "$COUNT" "$OFFICIAL" "$AUR"
fi
